# ---------------------------------------------------------------
# XPENG FUTURE NIGHT — backend config
# Copy to backend/.env and edit. APP_KEY is generated on first run
# if missing; keep a backup of it outside the database.
# ---------------------------------------------------------------

PORT=3000

# --- first admin account (seeded on first run only) ---
# After the account exists, changing these has no effect — use the
# dashboard's Password button, or create users via /api/admin/users.
ADMIN_USER=admin
ADMIN_PASS=change-me-before-staging
ADMIN_NAME=Campaign admin

# --- sessions ---
# true once the app is served over HTTPS, so the session cookie is
# never transmitted in the clear.
COOKIE_SECURE=false

# --- encryption key for personal columns (32+ chars) ---
# APP_KEY=

# --- database: sqlite (local, default) or mysql (staging/prod) ---
DB_DRIVER=sqlite
DB_FILE=./backend/data/future-night.db

# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=xpeng
# DB_PASSWORD=
# DB_NAME=xpeng_future_night
# DB_POOL=10

# --- comms: true drains the queue to backend/data/outbox.log ---
# --- where the public campaign page is hosted ---
# The dashboard's "View landing page" button links here. Change it
# when the front-end moves to its own domain.
PUBLIC_SITE_URL=https://x-peng.netlify.app

# --- outbound email ---
# One identity for every campaign message. The sending domain must
# authorise it (SPF/DKIM) or mail lands in spam.
MAIL_FROM="XPENG Philippines <marketing@xpengphilippines.com>"
MAIL_REPLY_TO=marketing@xpengphilippines.com

# SMTP for that mailbox. 587 = STARTTLS, 465 = implicit TLS.
# Google Workspace: smtp.gmail.com:587 with an App Password.
# Microsoft 365:    smtp.office365.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=marketing@xpengphilippines.com
SMTP_PASS=
# SMTP_SECURE=true    # only to override the port default
# SMTP_POOL=3

# Where invited guests claim, supplied by SM Tickets. Until it exists,
# invitations link back to the campaign page.
SM_CLAIM_URL=

# --- comms ---
# true keeps every message in backend/data/outbox.log and sends nothing.
# Set false only once MAIL_FROM and SMTP_* above are real.
COMMS_DRY_RUN=true

# --- public write path: submissions per IP per minute ---
RATE_LIMIT=30
